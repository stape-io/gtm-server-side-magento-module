<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="stape" translate="label" sortOrder="500">
            <label>Stape</label>
        </tab>

        <section id="stape_gtm" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="10" translate="label">
            <class>separator-top</class>
            <label>Stape Conversion Tracking</label>
            <tab>stape</tab>
            <resource>Stape_Gtm::config</resource>
            <group id="general" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="10" translate="label">
                <label>General</label>
                <field id="active" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="10" translate="label" type="select">
                    <label>Active</label>
                    <source_model>Magento\Config\Model\Config\Source\Enabledisable</source_model>
                </field>
                <field id="same_origin_active" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="15" translate="label" type="select">
                    <label><![CDATA[Same-origin proxy <span class="stape-badge">Beta</span>]]></label>
                    <source_model>Magento\Config\Model\Config\Source\Enabledisable</source_model>
                    <frontend_model>Stape\Gtm\Block\Adminhtml\System\Config\SameOrigin\Toggle</frontend_model>
                    <comment><![CDATA[The GTM loader is served from Stape through <strong>your own Magento server</strong>, so it loads first-party.<br />The proxying runs on infrastructure you control, and its load scales with your traffic.]]></comment>
                </field>
                <field id="same_origin_path" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="17" translate="label">
                    <label>Proxy path</label>
                    <frontend_model>Stape\Gtm\Block\Adminhtml\System\Config\SameOrigin\Path</frontend_model>
                    <backend_model>Stape\Gtm\Model\Backend\SameOriginPath</backend_model>
                    <depends>
                        <field id="stape_gtm/general/same_origin_active">1</field>
                    </depends>
                    <comment><![CDATA[The path on this domain that requests are proxied through. Must start with a slash. Save settings before testing.<br /><strong>After changing the path, refresh the Full Page Cache</strong> — pages cached earlier still reference the previous loader URL.]]></comment>
                </field>
                <field id="same_origin_api_key" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="18" translate="label" type="text">
                    <label>Container API key</label>
                    <depends>
                        <field id="stape_gtm/general/same_origin_active">1</field>
                    </depends>
                    <comment><![CDATA[Paste your container API key, found under <a href="https://app.stape.io/" target="_blank" rel="noopener noreferrer">Stape container settings</a> — <strong>not the container identifier</strong>.]]></comment>
                </field>

                <field id="container_id" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="12" translate="label">
                    <label>Web Google Tag Manager ID</label>
                    <depends>
                        <field id="stape_gtm/general/active">1</field>
                    </depends>
                    <comment><![CDATA[Enter the WEB Google Tag Manager ID, should be formatted as "GTM-XXXXXX".]]></comment>
                </field>
                <field id="custom_domain" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="30" translate="label">
                    <label>Custom Domain</label>
                    <depends>
                        <field id="stape_gtm/general/same_origin_active">0</field>
                    </depends>
                    <comment><![CDATA[If you use <a href="https://stape.io/gtm-server-hosting" target="_blank" rel="noopener noreferrer">stape.io sGTM hosting</a> you can find custom domain of your sGTM container URL following <a href="https://help.stape.io/hc/en-us/articles/6080905799453-Find-server-container-URL-for-sGTM-container" target="_blank" rel="noopener noreferrer">this guide</a>. Otherwise you can find sGTM container URL in the <a href="https://developers.google.com/tag-platform/tag-manager/server-side/app-engine-setup#4_add_the_server_url_to_google_tag_manager" target="_blank" rel="noopener noreferrer">container settings</a>. <a href="https://stape.io/blog/how-to-add-a-custom-domain-to-the-google-tag-manager-server-container" target="_blank" rel="noopener noreferrer">Custom domain</a> is used to set first party cookies. Leave empty if you want to use googletagmanager.com domain.]]></comment>
                    <validate>validate-https-url</validate>
                </field>
                <field id="custom_loader" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="40" translate="label">
                    <label>Custom Loader</label>
                    <frontend_model>Stape\Gtm\Block\Adminhtml\System\Config\CustomLoader</frontend_model>
                    <backend_model>Stape\Gtm\Model\Backend\CustomLoader</backend_model>
                    <depends>
                        <field id="stape_gtm/general/same_origin_active">0</field>
                    </depends>
                    <comment><![CDATA[Add stape container identifier. Follow <a href="https://help.stape.io/hc/en-us/articles/9697466601373-How-to-find-the-Stape-container-identifier" target="_blank" rel="noopener noreferrer">this guide</a> to find stape container identifier.
This feature is available only if you use <a href="https://stape.io/gtm-server-hosting" target="_blank" rel="noopener noreferrer">stape.io sGTM hosting</a> and enabled <a href="https://help.stape.io/hc/en-us/articles/6080917962397-Set-up-custom-web-GTM-loader" target="_blank" rel="noopener noreferrer">Custom Loader power up.</a> Custom loader allows you to increase the accuracy of tracking. ]]></comment>
                </field>
                <field id="cookie_keeper" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="60" translate="label" type="select">
                    <label>Cookie Keeper</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="stape_gtm/general/same_origin_active">0</field>
                    </depends>
                    <comment><![CDATA[Cookie Keeper is used to <a href="https://stape.io/blog/increase-first-party-cookie-lifetime-set-by-a-third-party-ip" target="_blank" rel="noopener noreferrer">prolong cookie lifetime</a> in Safari and other browsers with ITP. This option available only if you use <a href="https://stape.io/gtm-server-hosting" target="_blank" rel="noopener noreferrer">stape.io sGTM hosting</a> and set up <a href="https://stape.io/blog/increase-first-party-cookie-lifetime-set-by-a-third-party-ip#how-cookie-keeper-works" target="_blank" rel="noopener noreferrer">Cookie Keeper power up.</a>]]></comment>
                </field>
            </group>
            <group id="datalayer" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="10" translate="label">
                <label>Data Layer</label>
                <field id="ecom" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="10" translate="label" type="select">
                    <label>Add ecommerce Data Layer events</label>
                    <source_model>Magento\Config\Model\Config\Source\Enabledisable</source_model>
                </field>
                <field id="userdata" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="10" translate="label" type="select">
                    <label>Add user data to Data Layer events</label>
                    <source_model>Magento\Config\Model\Config\Source\Enabledisable</source_model>
                </field>
                <field id="stape_suffix_active" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="15" translate="label" type="select">
                    <label>Stape Suffix Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Enabledisable</source_model>
                </field>
                <field id="collection_size" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="20" translate="label">
                    <label>Product Collection Limit</label>
                    <validate>validate-integer</validate>
                </field>
            </group>
            <group id="transition" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="15" translate="label comment">
                <label>Transition Settings</label>
                <fieldset_css>stape-transition-settings</fieldset_css>
                <frontend_model>Stape\Gtm\Block\Adminhtml\System\Config\Fieldset\Transition</frontend_model>
                <attribute type="expanded">1</attribute>
                <comment><![CDATA[These settings maintain the exact data that is being sent as of today.<br />
Enabling them applies the changes that we will push in the near future,<br />
and it will be the default approach in future releases.]]></comment>
                <field id="exclude_item_price_tax" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="10" translate="label comment" type="select" canRestore="1">
                    <label>Exclude Tax from Item Price</label>
                    <config_path>stape_gtm/datalayer/exclude_item_price_tax</config_path>
                    <source_model>Magento\Config\Model\Config\Source\Enabledisable</source_model>
                    <comment><![CDATA[When enabled, item prices (and line totals) pushed to the data layer exclude tax. Disabled by default - item prices include tax.]]></comment>
                </field>
                <field id="use_display_currency" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="20" translate="label comment" type="select" canRestore="1">
                    <label>Use Display Currency for Amounts</label>
                    <config_path>stape_gtm/datalayer/use_display_currency</config_path>
                    <source_model>Magento\Config\Model\Config\Source\Enabledisable</source_model>
                    <comment><![CDATA[When enabled, every amount and currency code pushed to the data layer uses the storefront display currency. Disabled by default - amounts and currency codes use the website base currency. Applies to all events, including the server-side purchase and refund webhooks.]]></comment>
                </field>
            </group>
            <group id="webhooks" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="20" translate="label">
                <label>Webhooks</label>
                <field id="active" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="10" translate="label" type="select">
                    <label>Enable Webhooks</label>
                    <source_model>Magento\Config\Model\Config\Source\Enabledisable</source_model>
                </field>
                <field id="gtm_container_url" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="10" translate="label">
                    <label>GTM server container URL</label>
                    <validate>validate-url</validate>
                    <comment><![CDATA[If you use <a href="https://stape.io/gtm-server-hosting" target="_blank" rel="noopener noreferrer">stape.io sGTM hosting</a> you can find sGTM container URL following <a href="https://help.stape.io/hc/en-us/articles/6080905799453-Find-server-container-URL-for-sGTM-container" target="_blank" rel="noopener noreferrer">this guide.</a> Otherwise you can find sGTM container URL in the <a href="https://developers.google.com/tag-platform/tag-manager/server-side/app-engine-setup#4_add_the_server_url_to_google_tag_manager" target="_blank" rel="noopener noreferrer">container settings.</a>]]></comment>
                </field>
                <field id="purchase" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="10" translate="label" type="select">
                    <label>Purchase Webhook</label>
                    <source_model>Magento\Config\Model\Config\Source\Enabledisable</source_model>
                </field>
                <field id="purchase_order_state" translate="label" type="select" sortOrder="15" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Required Order State For Purchase</label>
                    <source_model>Stape\Gtm\Model\Config\Source\Order\PurchaseStatuses</source_model>
                </field>
                <field id="refund" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="20" translate="label" type="select">
                    <label>Refund Webhook</label>
                    <source_model>Magento\Config\Model\Config\Source\Enabledisable</source_model>
                </field>
                <field id="test" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="30" translate="label" type="button">
                    <label>Send test webhook</label>
                    <frontend_model>Stape\Gtm\Block\Adminhtml\System\Config\Webhook\Button\Test</frontend_model>
                </field>
            </group>
        </section>
    </system>
</config>
